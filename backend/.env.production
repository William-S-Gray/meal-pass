NODE_ENV=production
PORT=5000

# MongoDB connection
MONGO_URI=mongodb://mealpass_user:mealpass_password@localhost:27017/mealpass?authSource=mealpass

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Enable authentication (set to true to enable admin login)
ENABLE_AUTH=false

# Frontend URL for CORS
FRONTEND_URL=http://localhost:8080

# Base URL for generating QR codes and images
BASE_URL=http://localhost:5000

# Logging level
LOG_LEVEL=info